# Python build / cache artifacts
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.pytest_cache/
.ipynb_checkpoints/

# Local cache for on-demand downloads (the full PCA encoding)
.cache/

# Keep the bundled package-data artifacts tracked even if a broad *.npz rule is
# ever added: the shipped weights and PCA/UMAP/PLS encodings are intentional.
!encotess/weights/*.npz
!encotess/data/*.npz

# Staging area for the large file uploaded to HuggingFace (too big for git)
dist/
